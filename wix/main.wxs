<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64 ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?endif ?>

<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>
    <Product Id='*' Name='file-monitor-agent' UpgradeCode='48C5CDCF-A086-41E5-A72B-ED85F89B7C9A' Manufacturer='Rafal Curzydlo' Language='1033' Codepage='1252' Version='$(var.Version)'>
        
        <Package Id='*' Keywords='Installer' Description='Agent do monitorowania plikow i synchronizacji z baza danych.' Manufacturer='Rafal Curzydlo' InstallerVersion='450' Languages='1033' Compressed='yes' InstallScope='perMachine' SummaryCodepage='1252' />
        
        <MajorUpgrade Schedule='afterInstallInitialize' DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>
        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1'/>
        <Property Id='DiskPrompt' Value='file-monitor-agent Installation'/>

        <!-- 1. STRUKTURA KATALOGÓW -->
        <Directory Id='TARGETDIR' Name='SourceDir'>
            
            <!-- Folder w Menu Start -->
            <Directory Id="ProgramMenuFolder" Name="Programs">
                <Directory Id="ApplicationProgramsFolder" Name="File Monitor Agent"/>
            </Directory>

            <!-- Pliki Programu -->
            <Directory Id='$(var.PlatformProgramFilesFolder)' Name='PFiles'>
                <Directory Id='APPLICATIONFOLDER' Name='file-monitor-agent'>
                    <Directory Id='Bin' Name='bin'>
                        
                        <!-- Sam plik .exe (BEZ SKRÓTU TUTAJ) -->
                        <Component Id='binary0' Guid='*'>
                            <File Id='exe0' Name='file-monitor-agent.exe' DiskId='1' Source='$(var.CargoTargetBinDir)\file-monitor-agent.exe' KeyPath='yes'/>
                        </Component>

                        <Component Id='Path' Guid='408CAA29-F094-4D27-9E69-760C1EB8B3A2' KeyPath='yes'>
                            <Environment Id='PATH' Name='PATH' Value='[Bin]' Permanent='no' Part='last' Action='set' System='yes'/>
                        </Component>
                    </Directory>
                </Directory>
            </Directory>
        </Directory>

        <!-- 2. PROFESJONALNY SKRÓT Z WPISEM DO REJESTRU -->
        <DirectoryRef Id="ApplicationProgramsFolder">
            <Component Id="ApplicationShortcut" Guid="*">
                <!-- Tworzenie skrótu -->
                <Shortcut Id="StartMenuShortcut" 
                          Name="File Monitor Agent" 
                          Description="Monitoruje zmiany w plikach i synchronizuje z bazą" 
                          Target="[#exe0]" 
                          WorkingDirectory="Bin" />
                <!-- Sprzątanie folderu przy usuwaniu -->
                <RemoveFolder Id="CleanUpShortCut" Directory="ApplicationProgramsFolder" On="uninstall"/>
                <!-- Wymagany przez WiX klucz w rejestrze -->
                <RegistryValue Root="HKLM" Key="Software\RafalCurzydlo\FileMonitorAgent" Name="installed" Type="integer" Value="1" KeyPath="yes"/>
                            </Component>
        </DirectoryRef>

        <!-- 3. DODANIE KOMPONENTÓW DO INSTALATORA -->
        <Feature Id='Binaries' Title='Application' Description='Installs all binaries.' Level='1' ConfigurableDirectory='APPLICATIONFOLDER' AllowAdvertise='no' Display='expand' Absent='disallow'>
            <ComponentRef Id='binary0'/>
            <ComponentRef Id='ApplicationShortcut'/> <!-- MUSI TU BYĆ -->
            
            <Feature Id='Environment' Title='PATH Environment Variable' Description='Add the install location to the PATH system environment variable.' Level='1' Absent='allow'>
                <ComponentRef Id='Path'/>
            </Feature>
        </Feature>

        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>
        <Property Id='ARPHELPLINK' Value='https://github.com/Szadolowski/monitoring_app'/>
        
        <UI>
            <UIRef Id='WixUI_FeatureTree'/>
            <Publish Dialog='WelcomeDlg' Control='Next' Event='NewDialog' Value='CustomizeDlg' Order='99'>1</Publish>
            <Publish Dialog='CustomizeDlg' Control='Back' Event='NewDialog' Value='WelcomeDlg' Order='99'>1</Publish>
        </UI>
    </Product>
</Wix>