# .gitignore for Rust application
# See https://github.com/github/gitignore/blob/main/Rust.gitignore for reference

# Compiled output
/target/

# Cargo build metadata
/**/target/
/.fingerprint/
/incremental/

# Environment files
.env
.env.local

# Ignore editor/project files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS generated files
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
*.tmp
*.swp
*~

# Compiled binaries
*.exe
*.dll
*.so
*.dylib
*.rlib

# Node/npm
node_modules/
dist/
build/

# Coverage
coverage/
coverage-final.json

# Ignore target debug artifacts and incremental build folders
target/debug/
target/release/